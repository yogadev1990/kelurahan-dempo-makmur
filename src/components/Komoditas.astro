---
// Komoditas.astro
---

<!-- Wave Divider (from toga to komoditas) -->
<div class="wave-divider" aria-hidden="true" style="background:var(--clr-mist);">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,0 C480,60 960,0 1440,40 L1440,60 L0,60 Z" fill="var(--clr-gray-800)"/>
  </svg>
</div>

<section class="section section-komoditas" id="komoditas" aria-labelledby="komoditas-title">
  <div class="container" style="position:relative;z-index:1;">

    <header class="section-header">
      <span
        class="eyebrow"
        style="background:rgba(160,98,42,0.2);color:var(--clr-coffee-300);"
      >
        🌾 Komoditas Unggulan
      </span>
      <h2 class="section-title" id="komoditas-title">
        Potensi Komoditas <span>Kelurahan Dempo Makmur</span>
      </h2>
      <p class="section-desc" style="color:rgba(255,255,255,0.65);">
        Kelurahan Dempo Makmur memiliki potensi pertanian dan perkebunan yang menjadi bagian dari kekuatan ekonomi masyarakat. Berada di wilayah Pagar Alam Utara, kawasan ini memiliki lingkungan yang mendukung berbagai kegiatan pertanian dan perkebunan.
      </p>
    </header>

    <div class="komoditas-grid">

      <article class="komoditas-card reveal reveal-delay-1" id="komoditas-kopi">
        <div class="komoditas-header">
          <span class="komoditas-emoji" aria-hidden="true">☕</span>
          <div>
            <h3 class="komoditas-name" id="komoditas-name-1">1. Kopi Robusta</h3>
            <div class="komoditas-subtitle">Kopi Robusta Pagar Alam</div>
          </div>
        </div>
        <p class="komoditas-desc" id="komoditas-desc-1">
          Kopi robusta menjadi salah satu komoditas perkebunan unggulan di wilayah Pagar Alam. Komoditas ini memiliki karakter cita rasa yang kuat dan menjadi salah satu hasil perkebunan yang penting bagi masyarakat. Kopi robusta juga tercatat sebagai komoditas unggulan perkebunan di wilayah Pagar Alam Utara.
        </p>
      </article>

      <article class="komoditas-card reveal reveal-delay-2" id="komoditas-sayur">
        <div class="komoditas-header">
          <span class="komoditas-emoji" aria-hidden="true">🥬</span>
          <div>
            <h3 class="komoditas-name" id="komoditas-name-3">2. Hortikultura</h3>
            <div class="komoditas-subtitle">Sayuran & Tanaman Pangan</div>
          </div>
        </div>
        <p class="komoditas-desc" id="komoditas-desc-3">
          Selain komoditas perkebunan, wilayah Pagar Alam juga dikenal dengan berbagai tanaman hortikultura seperti sayuran dan tanaman pangan. Komoditas hortikultura yang berkembang di wilayah Pagar Alam antara lain cabai, wortel, sawi, kubis, dan tomat.
        </p>
      </article>

    </div>

    <!-- Coffee & Tea Banner Image -->
    <div
      class="reveal"
      style="margin-top:3rem;border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-xl);max-height:260px;"
    >
      <img
        src="/images/coffee_tea.png"
        alt="Biji kopi robusta dan daun teh hijau khas Gunung Dempo"
        style="width:100%;height:260px;object-fit:cover;object-position:center;"
        loading="lazy"
        width="1200"
        height="400"
      />
    </div>

  </div>
</section>



<style>
  .komoditas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
  }

  .komoditas-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    transition: transform var(--transition-bounce), background var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .komoditas-card:hover {
    transform: translateY(-8px);
    background: rgba(255,255,255,0.07);
    box-shadow: 0 20px 45px rgba(0,0,0,0.3);
    border-color: rgba(255,255,255,0.15);
  }

  .komoditas-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .komoditas-emoji {
    font-size: 2.2rem;
    line-height: 1;
    margin-bottom: 0;
    display: block;
    animation: floatSlow 7s ease-in-out infinite;
  }

  .komoditas-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: white;
    margin-bottom: 0.15rem;
  }

  .komoditas-subtitle {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--clr-coffee-300);
  }

  .komoditas-card#komoditas-sayur .komoditas-subtitle {
    color: var(--clr-emerald-400);
  }

  .komoditas-desc {
    font-size: 0.84rem;
    color: rgba(255,255,255,0.68);
    line-height: 1.65;
    margin: 0;
  }

  .komoditas-footer {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: var(--space-sm);
    margin-top: auto;
  }

  .komoditas-stat {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--clr-emerald-400);
    line-height: 1.2;
  }

  .komoditas-card#komoditas-kopi .komoditas-stat {
    color: var(--clr-coffee-300);
  }

  .komoditas-stat-label {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.45);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @keyframes floatSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (max-width: 768px) {
    .komoditas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
