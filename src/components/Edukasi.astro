---
// src/components/Edukasi.astro — Pustaka Konten Edukasi Kelurahan Dempo Makmur
---

<section class="section section-edukasi" id="edukasi" aria-labelledby="edukasi-title">
  <div class="container">

    <!-- Section Header -->
    <header class="section-header reveal">
      <span class="eyebrow" style="background:rgba(245,158,11,0.1);color:#d97706;">📚 Pusat Unduh & Informasi</span>
      <h2 class="section-title" id="edukasi-title">
        Media & <span>Modul Edukasi Masyarakat</span>
      </h2>
      <p class="section-desc">
        Pustaka materi edukasi kesehatan, modul stunting, kesehatan gigi balita, pengelolaan sampah, 
        serta panduan tanaman obat keluarga hasil kerja sama akademis KKNT 103 Unsri.
      </p>
    </header>

    <!-- Edukasi Grid -->
    <div class="edukasi-grid" id="edukasi-grid" role="list">
      <!-- Loading skeletons -->
      <div class="edu-skeleton"></div>
      <div class="edu-skeleton"></div>
      <div class="edu-skeleton"></div>
    </div>

  </div>
</section>

<style>
  .section-edukasi {
    background: linear-gradient(180deg, #fff5f7 0%, #ffffff 100%);
    padding-block: var(--space-5xl);
    position: relative;
  }

  .edukasi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  /* Edukasi Card */
  :global(.edu-card) {
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-gray-200);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    transition: transform var(--transition-bounce), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  :global(.edu-card:hover) {
    transform: translateY(-5px);
    border-color: rgba(245,158,11,0.3);
    box-shadow: 0 16px 36px rgba(245, 158, 11, 0.08);
  }

  :global(.edu-card-header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  :global(.edu-card-icon) {
    font-size: 2.2rem;
    width: 60px;
    height: 60px;
    background: #fffbeb;
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    border: 1px solid #fde68a;
  }

  :global(.edu-card-badge) {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: #fef3c7;
    color: #b45309;
    border: 1px solid #fde68a;
  }

  :global(.edu-card-body) {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.edu-card-title) {
    font-size: 1rem;
    font-weight: 800;
    color: var(--clr-gray-800);
    line-height: 1.4;
  }

  :global(.edu-card-footer) {
    margin-top: auto;
  }

  :global(.edu-dl-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, #d97706, #fbbf24);
    border: none;
    padding: 0.65rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
    transition: transform var(--transition-bounce), box-shadow var(--transition-base);
  }

  :global(.edu-dl-btn:hover) {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(245, 158, 11, 0.35);
  }

  /* Skeleton Loading */
  .edu-skeleton {
    height: 220px;
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-gray-200);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .edu-skeleton::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<script>
  const API_URL = 'https://script.google.com/macros/s/AKfycbw4l44YbYf-GNZFFau0vUPdX9kzgHuRKSk0ZNjCLNrU17BYXANM-WIEMm_Z-BL0Xkow/exec';

  interface EduItem {
    title: string;
    category: string;
    downloadUrl: string;
  }

  const EDU_EMOJIS: Record<string, string> = {
    'Stunting': '👶',
    'Kesehatan Gigi': '🦷',
    'Sampah': '🗑️',
    'TOGA': '🌿',
  };

  function renderEdukasi(items: EduItem[]): void {
    const grid = document.getElementById('edukasi-grid');
    if (!grid) return;

    if (items.length === 0) {
      grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: var(--clr-gray-400); padding: 3rem; font-style: italic;">Tidak ada modul edukasi yang dipublikasikan saat ini.</p>';
      return;
    }

    grid.innerHTML = items.map(item => {
      const emoji = EDU_EMOJIS[item.category] || '📚';
      const link = item.downloadUrl && item.downloadUrl !== '-' ? item.downloadUrl : '#';
      const isDownloadable = link !== '#';

      return `
        <article class="edu-card reveal visible" role="listitem">
          <div class="edu-card-header">
            <div class="edu-card-icon">${emoji}</div>
            <span class="edu-card-badge">${item.category}</span>
          </div>
          <div class="edu-card-body">
            <h3 class="edu-card-title">${item.title}</h3>
          </div>
          <div class="edu-card-footer">
            ${isDownloadable ? `
              <a href="${link}" target="_blank" rel="noopener noreferrer" class="edu-dl-btn">
                <span>⬇️ Unduh Modul PDF</span>
              </a>
            ` : `
              <button disabled class="edu-dl-btn" style="background:#e2e8f0; color:#94a3b8; box-shadow:none; cursor:not-allowed;">
                <span>🔒 Segera Hadir</span>
              </button>
            `}
          </div>
        </article>
      `;
    }).join('');
  }

  async function loadEdukasi(): Promise<void> {
    try {
      const res = await fetch(API_URL);
      if (!res.ok) throw new Error();
      const payload = await res.json();
      const rawEdu = payload.KONTEN_EDUKASI || [];

      const eduItems = rawEdu
        .filter((item: any) => item["Status Publish"] === 'Ya' && item["Judul Modul / Poster"] && item["Judul Modul / Poster"].trim() !== '')
        .map((item: any) => ({
          title: item["Judul Modul / Poster"],
          category: item.Kategori || 'Lainnya',
          downloadUrl: item["Tautan Unduh (Drive/PDF)"] || '-'
        }));

      renderEdukasi(eduItems);
    } catch {
      const grid = document.getElementById('edukasi-grid');
      if (grid) grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: var(--clr-gray-400); padding: 3rem; font-style: italic;">Gagal memuat materi edukasi, silakan coba lagi.</p>';
    }
  }

  loadEdukasi();
</script>
