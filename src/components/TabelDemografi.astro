    'Petani': '🌾',
    'Pegawai Negeri': '🏛️',
    'Pegawai Perusahaan': '🏢',
    'Tukang Batu': '🧱',
    'Tukang Kayu': '🪵',
    'Pengrajin': '🎨',
    'Pedagang': '🏪',
    'Pengusaha': '💼',
    'Sopir': '🚗',
    'Montir': '🛠️',
    'Penjahit': '🧵',
    'Peternak': '🐄',
    'TNI Polri': '🪖',
    'Buruh Swasta': '👷',
    'Buruh/Swasta': '👷',
    'Dokter': '🩺',
  };

  const AGAMA_EMOJIS: Record<string, string> = {
    'Islam': '🕌',
    'Kristen': '⛪',
    'Katholik': '✝️',
    'Hindu': '🛕',
    'Budha': '☸️',
  };

  interface RWRowData {
    id: number;
    name: string;
    dusun: string;
    rtList: string;
    kk: number;
    laki: number;
    perempuan: number;
    total: number;
  }

  let tableDataStore: RWRowData[] = [];

  function formatNumber(num: number): string {
    return num.toLocaleString('id-ID');
  }

  function parseDemografiPayload(payload: any) {
    const rwInfo = payload.RW_DEMPO_MAKMUR || FALLBACK_PAYLOAD.RW_DEMPO_MAKMUR;
    const popInfo = payload.JUMLAH_PENDUDUK || FALLBACK_PAYLOAD.JUMLAH_PENDUDUK;
    const eduInfo = payload.PENDIDIKAN_PENDUDUK || FALLBACK_PAYLOAD.PENDIDIKAN_PENDUDUK;
    const jobInfo = payload.PEKERJAAN_PENDUDUK || FALLBACK_PAYLOAD.PEKERJAAN_PENDUDUK;
    const relInfo = payload.AGAMA_PENDUDUK || FALLBACK_PAYLOAD.AGAMA_PENDUDUK;

    const rows: RWRowData[] = [];
    let sumP = 0;
    let sumL = 0;
    let sumF = 0;
    let sumKK = 0;

    rwInfo.forEach((rwItem: any) => {
      const rwNum = parseInt(rwItem.RW, 10);
      const popItem = popInfo.find((p: any) => parseInt(p.RW, 10) === rwNum) || {};
      
      const l = parseInt(popItem["Laki-Laki"] ?? popItem.Laki_Laki, 10) || 0;
      const f = parseInt(popItem.Perempuan, 10) || 0;
      const kk = parseInt(popItem.KK, 10) || 0;
      const total = parseInt(popItem.Jumlah, 10) || (l + f);

      sumP += total;
      sumL += l;
      sumF += f;
      sumKK += kk;

      rows.push({
        id: rwNum,
        name: `RW ${rwNum < 10 ? '0' + rwNum : rwNum}`,
        dusun: rwItem["Nama Dusun"] || "-",
        rtList: rwItem.RT ? `RT ${rwItem.RT}` : "-",
        kk,
        laki: l,
        perempuan: f,
        total
      });
    });

    /* Extract Pekerjaan */
    const pekerjaanItems: { label: string; count: number; emoji: string }[] = [];
    jobInfo.forEach((item: any) => {
      const count = parseInt(item.Jumlah, 10);
      if (!isNaN(count) && count > 0) {
        const label = item["Mata Pencaharian Pokok"] || "";
        const emoji = JOB_EMOJIS[label] || '💼';
        pekerjaanItems.push({ label, count, emoji });
      }
    });
    pekerjaanItems.sort((a, b) => b.count - a.count);

    /* Extract Agama */
    const agamaItems: { label: string; count: number; emoji: string }[] = [];
    relInfo.forEach((item: any) => {
      const label = item.Agama || "";
      const count = parseInt(item.Jumlah, 10) || 0;
      const emoji = AGAMA_EMOJIS[label] || '☸️';
      agamaItems.push({ label, count, emoji });
    });

    /* Extract Pendidikan (Education) */
    const eduTotals = { sd: 0, sltp: 0, slta: 0, diploma: 0, sarjana: 0, pascasarjana:0 };
    eduInfo.forEach((item: any) => {
      eduTotals.sd += parseInt(item["SD Sederajat (J)"], 10) || 0;
      eduTotals.sltp += parseInt(item["SLTP Sederajat (J)"], 10) || 0;
      eduTotals.slta += parseInt(item["SLTA Sederajat (J)"], 10) || 0;
      eduTotals.diploma += parseInt(item["Akademi/Diploma (J)"] ?? item["Akademi/Diploma (J)"], 10) || 0;
      eduTotals.sarjana += parseInt(item["Sarjana (J)"], 10) || 0;
      eduTotals.pascasarjana += parseInt(item["Pascasarjana (J)"], 10) || 0;
    });

    const pendidikanItems = [
      { label: 'SD Sederajat', count: eduTotals.sd, emoji: '🎒' },
      { label: 'SLTP Sederajat', count: eduTotals.sltp, emoji: '🏫' },
      { label: 'SLTA Sederajat', count: eduTotals.slta, emoji: '📜' },
      { label: 'Akademi / Diploma', count: eduTotals.diploma, emoji: '🎓' },
      { label: 'Sarjana (S1/S2/S3)', count: eduTotals.sarjana, emoji: '👩‍🎓' },
      { label: 'Pascasarjana', count: eduTotals.pascasarjana, emoji: '🎓' },
    ];

    return { rows, totalPenduduk: sumP, totalLaki: sumL, totalPerempuan: sumF, totalKK: sumKK, pekerjaanItems, agamaItems, pendidikanItems };
  }

  function renderTable(rows: RWRowData[], grandTotal: number): void {
    const tbody = document.getElementById('demo-table-body');
    if (!tbody) return;

    if (rows.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--clr-gray-400);">Tidak ada data RW ditemukan.</td></tr>';
      return;
    }

    tbody.innerHTML = rows.map((r, idx) => {
      const pct = grandTotal > 0 ? ((r.total / grandTotal) * 100).toFixed(1) : '0';
      return `
        <tr>
          <td style="font-weight: 700; color: var(--clr-gray-400); text-align: center;">${idx + 1}</td>
          <td><strong>${r.dusun}</strong></td>
          <td style="text-align: center; font-weight: 600;">${r.rtList}</td>
          <td style="text-align: center; font-weight: 600;">${formatNumber(r.kk)}</td>
          <td style="text-align: center; font-weight: 600;">${formatNumber(r.laki)}</td>
          <td style="text-align: center; font-weight: 600;">${formatNumber(r.perempuan)}</td>
          <td style="text-align: center; font-weight: 800; color: var(--clr-gray-900);">${formatNumber(r.total)}</td>
          <td>
            <div class="prop-bar-cell">
              <div class="prop-track">
                <div class="prop-fill" style="width: ${pct}%;"></div>
              </div>
              <span class="prop-val">${pct}%</span>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function renderWidgets(pekerjaan: any[], agama: any[], pendidikan: any[]) {
    // Pekerjaan Widget
    const pContainer = document.getElementById('widget-pekerjaan-container');
    if (pContainer) {
      if (pekerjaan.length === 0) {
        pContainer.innerHTML = '<p class="widget-loading">Belum ada data pekerjaan terdata.</p>';
      } else {
        const totalPekerja = pekerjaan.reduce((acc, item) => acc + item.count, 0);
        pContainer.innerHTML = `
          <div class="pekerjaan-list">
            ${pekerjaan.map(item => {
              const pct = totalPekerja > 0 ? ((item.count / totalPekerja) * 100).toFixed(1) : '0';
              return `
                <div class="pekerjaan-item">
                  <div class="pekerjaan-meta">
                    <span class="pekerjaan-label">${item.emoji} ${item.label}</span>
                    <span class="pekerjaan-val">${formatNumber(item.count)} Orang (${pct}%)</span>
                  </div>
                  <div class="pekerjaan-track">
                    <div class="pekerjaan-fill" style="width: ${pct}%;"></div>
                  </div>
                </div>`;
            }).join('')}
          </div>`;
      }
    }

    // Agama Widget
    const aContainer = document.getElementById('widget-agama-container');
    if (aContainer) {
      if (agama.length === 0) {
        aContainer.innerHTML = '<p class="widget-loading">Belum ada data agama terdata.</p>';
      } else {
        aContainer.innerHTML = `
          <div class="agama-grid">
            ${agama.map(item => `
              <div class="agama-card">
                <span class="agama-icon">${item.emoji}</span>
                <div>
                  <div class="agama-count">${item.count > 0 ? formatNumber(item.count) : '-'}</div>
                  <div class="agama-name">${item.label}</div>
                </div>
              </div>`).join('')}
          </div>`;
      }
    }

    // Pendidikan Widget
    const eduContainer = document.getElementById('widget-pendidikan-container');
    if (eduContainer) {
      const totalEducated = pendidikan.reduce((acc, item) => acc + item.count, 0);
      if (totalEducated === 0) {
        eduContainer.innerHTML = '<p class="widget-loading">Belum ada data pendidikan terdata.</p>';
      } else {
        eduContainer.innerHTML = `
          <div class="pekerjaan-list">
            ${pendidikan.map(item => {
              const pct = totalEducated > 0 ? ((item.count / totalEducated) * 100).toFixed(1) : '0';
              return `
                <div class="pekerjaan-item">
                  <div class="pekerjaan-meta">
                    <span class="pekerjaan-label">${item.emoji} ${item.label}</span>
                    <span class="pekerjaan-val">${formatNumber(item.count)} Jiwa (${pct}%)</span>
                  </div>
                  <div class="pekerjaan-track">
                    <div class="pekerjaan-fill" style="width: ${pct}%; background: linear-gradient(90deg, #d97706, #fbbf24);"></div>
                  </div>
                </div>`;
            }).join('')}
          </div>`;
      }
    }
  }

  function updateSummary(totalP: number, totalL: number, totalF: number, totalKK: number): void {
    const elTotalP = document.getElementById('demo-total-penduduk');
    const elTotalL = document.getElementById('demo-total-laki');
    const elTotalF = document.getElementById('demo-total-perempuan');
    const elTotalKK = document.getElementById('demo-total-kk');
    const elPctL   = document.getElementById('demo-pct-laki');
    const elPctF   = document.getElementById('demo-pct-perempuan');

    const elFootKK = document.getElementById('foot-total-kk');
    const elFootL = document.getElementById('foot-total-laki');
    const elFootF = document.getElementById('foot-total-perempuan');
    const elFootP = document.getElementById('foot-total-penduduk');

    if (elTotalP) elTotalP.textContent = formatNumber(totalP);
    if (elTotalL) elTotalL.textContent = formatNumber(totalL);
    if (elTotalF) elTotalF.textContent = formatNumber(totalF);
    if (elTotalKK) elTotalKK.textContent = formatNumber(totalKK);

    if (elFootKK) elFootKK.textContent = formatNumber(totalKK);
    if (elFootL) elFootL.textContent = formatNumber(totalL);
    if (elFootF) elFootF.textContent = formatNumber(totalF);
    if (elFootP) elFootP.textContent = formatNumber(totalP);

    if (totalP > 0) {
      if (elPctL) elPctL.textContent = `${((totalL / totalP) * 100).toFixed(1)}%`;
      if (elPctF) elPctF.textContent = `${((totalF / totalP) * 100).toFixed(1)}%`;
    }

    window.dispatchEvent(new CustomEvent('demografi-loaded', {
      detail: { totalPenduduk: totalP, totalLaki: totalL, totalPerempuan: totalF, totalKK }
    }));
  }

  async function loadDemografi(): Promise<void> {
    const statusDot  = document.getElementById('demo-api-dot');
    const statusText = document.getElementById('demo-api-status');

    try {
      const res = await fetch(API_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const payload = await res.json();

      const parsed = parseDemografiPayload(payload);
      tableDataStore = parsed.rows;

      renderTable(tableDataStore, parsed.totalPenduduk);
      renderWidgets(parsed.pekerjaanItems, parsed.agamaItems, parsed.pendidikanItems);
      updateSummary(parsed.totalPenduduk, parsed.totalLaki, parsed.totalPerempuan, parsed.totalKK);

      if (statusDot) statusDot.classList.add('online');
      if (statusText) statusText.textContent = '🟢 Terhubung · Google Sheets API Live (Demografi & Pendidikan)';
    } catch (err) {
      console.warn('Gagal memuat API Google Sheets, menggunakan data fallback:', err);
      const parsed = parseDemografiPayload({});
      tableDataStore = parsed.rows;

      renderTable(tableDataStore, parsed.totalPenduduk);
      renderWidgets(parsed.pekerjaanItems, parsed.agamaItems, parsed.pendidikanItems);
      updateSummary(parsed.totalPenduduk, parsed.totalLaki, parsed.totalPerempuan, parsed.totalKK);

      if (statusDot) statusDot.classList.add('online');
      if (statusText) statusText.textContent = '🟢 Mode Demo · Data API Siap Terhubung';
    }
  }

  // Filter / Search Handler
  const searchInput = document.getElementById('demo-search-input') as HTMLInputElement | null;
  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    if (!query) {
      const grandTotal = tableDataStore.reduce((acc, r) => acc + r.total, 0);
      renderTable(tableDataStore, grandTotal);
      return;
    }

    const filtered = tableDataStore.filter(r => 
      r.name.toLowerCase().includes(query) ||
      r.dusun.toLowerCase().includes(query) ||
      r.rtList.toLowerCase().includes(query)
    );
    const grandTotal = tableDataStore.reduce((acc, r) => acc + r.total, 0);
    renderTable(filtered, grandTotal);
  });

  // Init
  loadDemografi();
</script>
