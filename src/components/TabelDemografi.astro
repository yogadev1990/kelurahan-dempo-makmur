---
// TabelDemografi.astro — Data Demografi + Widget Pekerjaan & Agama Live API
---

<section class="section section-demografi" id="demografi" aria-labelledby="demografi-title">
  <div class="container">

    <!-- Section Header -->
    <header class="section-header reveal">
      <span class="eyebrow">📊 Data & Statistik Kependudukan</span>
      <h2 class="section-title" id="demografi-title">
        Tabel <span>Demografi & Profesi Penduduk</span>
      </h2>
      <p class="section-desc">
        Data kependudukan real-time per Rukun Tetangga (RT), sebaran pekerjaan/mata pencaharian,
        agama, dan kelompok tenaga kerja Kelurahan Dempo Makmur.
      </p>
    </header>

    <!-- Stat Summary Cards Row -->
    <div class="demografi-stats-grid reveal reveal-delay-1">
      <div class="demo-card demo-card-primary">
        <div class="demo-card-icon">👥</div>
        <div class="demo-card-info">
          <span class="demo-card-val" id="demo-total-penduduk">--</span>
          <span class="demo-card-lbl">Total Penduduk</span>
        </div>
        <span class="demo-card-badge">Jiwa</span>
      </div>

      <div class="demo-card">
        <div class="demo-card-icon">👨</div>
        <div class="demo-card-info">
          <span class="demo-card-val" id="demo-total-laki">--</span>
          <span class="demo-card-lbl">Laki-Laki</span>
        </div>
        <span class="demo-card-sub" id="demo-pct-laki">--%</span>
      </div>

      <div class="demo-card">
        <div class="demo-card-icon">👩</div>
        <div class="demo-card-info">
          <span class="demo-card-val" id="demo-total-perempuan">--</span>
          <span class="demo-card-lbl">Perempuan</span>
        </div>
        <span class="demo-card-sub" id="demo-pct-perempuan">--%</span>
      </div>

      <div class="demo-card">
        <div class="demo-card-icon">🏡</div>
        <div class="demo-card-info">
          <span class="demo-card-val" id="demo-total-kk">--</span>
          <span class="demo-card-lbl">Kepala Keluarga (KK)</span>
        </div>
        <span class="demo-card-badge demo-badge-gold">Dempo Makmur</span>
      </div>
    </div>

    <!-- Table Container Wrapper -->
    <div class="table-card-wrap reveal reveal-delay-2">
      <!-- Toolbar -->
      <div class="table-toolbar">
        <div class="table-status-bar">
          <span class="status-dot" id="demo-api-dot"></span>
          <span class="status-text" id="demo-api-status">⏳ Menghubungkan ke Database Google Sheets…</span>
        </div>

        <div class="table-search-wrap">
          <span class="search-icon">🔍</span>
          <input
            type="text"
            id="demo-search-input"
            placeholder="Cari Dusun, RW, atau RT..."
            aria-label="Cari Wilayah"
          />
        </div>
      </div>

      <!-- Table Scroll Wrapper -->
      <div class="table-responsive">
        <table class="demo-table" id="demo-data-table">
          <thead>
            <tr>
              <th scope="col" style="width: 60px; text-align: center;">RW</th>
              <th scope="col">Nama Dusun</th>
              <th scope="col" style="text-align: center;">Cakupan RT</th>
              <th scope="col" style="text-align: center;">Jumlah KK</th>
              <th scope="col" style="text-align: center;">Laki-Laki</th>
              <th scope="col" style="text-align: center;">Perempuan</th>
              <th scope="col" style="text-align: center;">Total Jiwa</th>
              <th scope="col" style="width: 150px;">Proporsi Wilayah</th>
            </tr>
          </thead>
          <tbody id="demo-table-body">
            <!-- Loading Skeleton Rows -->
            <tr class="row-skeleton">
              <td colspan="8"><div class="skeleton-line"></div></td>
            </tr>
            <tr class="row-skeleton">
              <td colspan="8"><div class="skeleton-line"></div></td>
            </tr>
            <tr class="row-skeleton">
              <td colspan="8"><div class="skeleton-line"></div></td>
            </tr>
          </tbody>
          <tfoot id="demo-table-foot">
            <tr class="total-row">
              <td colspan="3"><strong>Total Keseluruhan</strong></td>
              <td style="text-align: center;"><strong id="foot-total-kk">--</strong></td>
              <td style="text-align: center;"><strong id="foot-total-laki">--</strong></td>
              <td style="text-align: center;"><strong id="foot-total-perempuan">--</strong></td>
              <td style="text-align: center;"><strong id="foot-total-penduduk">--</strong></td>
              <td><strong>100%</strong></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- ===== ADDITIONAL WIDGETS ROW: PEKERJAAN, AGAMA & PENDIDIKAN ===== -->
    <div class="demografi-widgets-grid reveal reveal-delay-3">

      <!-- Widget 1: Mata Pencaharian & Pekerjaan Utama -->
      <div class="widget-card widget-pekerjaan">
        <div class="widget-header">
          <div class="widget-title">
            <span class="widget-icon">💼</span>
            <div>
              <strong class="widget-heading">Mata Pencaharian & Pekerjaan</strong>
              <span class="widget-sub">Sebaran profesi masyarakat Kelurahan</span>
            </div>
          </div>
          <span class="widget-badge badge-green">Live API Data</span>
        </div>
        <div class="widget-body" id="widget-pekerjaan-container">
          <div class="widget-loading">Memuat data pekerjaan...</div>
        </div>
      </div>

      <!-- Widget 2 & 3 Column: Agama & Pendidikan -->
      <div class="widget-column">

        <!-- Widget 2: Demografi Agama -->
        <div class="widget-card widget-agama">
          <div class="widget-header">
            <div class="widget-title">
              <span class="widget-icon">🕌</span>
              <div>
                <strong class="widget-heading">Demografi Agama</strong>
                <span class="widget-sub">Komposisi keyakinan penduduk</span>
              </div>
            </div>
            <span class="widget-badge badge-blue">Sensus Religi</span>
          </div>
          <div class="widget-body" id="widget-agama-container">
            <div class="widget-loading">Memuat data agama...</div>
          </div>
        </div>

        <!-- Widget 3: Pendidikan Penduduk -->
        <div class="widget-card widget-pendidikan">
          <div class="widget-header">
            <div class="widget-title">
              <span class="widget-icon">🎓</span>
              <div>
                <strong class="widget-heading">Tingkat Pendidikan</strong>
                <span class="widget-sub">Sebaran tingkat pendidikan warga</span>
              </div>
            </div>
            <span class="widget-badge badge-amber">Sensus Pendidikan</span>
          </div>
          <div class="widget-body" id="widget-pendidikan-container">
            <div class="widget-loading">Memuat data pendidikan...</div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .section-demografi {
    background: linear-gradient(180deg, var(--clr-mist) 0%, #fff 100%);
    padding-block: var(--space-5xl);
  }

  /* Stat Summary Grid */
  .demografi-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .demo-card {
    background: #ffffff;
    border: 1px solid var(--clr-gray-200);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .demo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .demo-card-primary {
    border-color: rgba(219, 39, 119, 0.3);
    background: linear-gradient(135deg, #ffffff, #fff1f2);
  }

  .demo-card-icon {
    font-size: 2rem;
    width: 52px;
    height: 52px;
    background: var(--clr-mist);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .demo-card-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .demo-card-val {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--clr-gray-900);
  }

  .demo-card-primary .demo-card-val {
    color: var(--clr-emerald-700);
  }

  .demo-card-lbl {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--clr-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .demo-card-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.68rem;
    font-weight: 700;
    background: var(--clr-emerald-100);
    color: var(--clr-emerald-800);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .demo-badge-gold {
    background: var(--clr-sage-100);
    color: var(--clr-sage-700);
  }

  .demo-card-sub {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--clr-gray-400);
  }

  /* Table Card Wrap */
  .table-card-wrap {
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--clr-gray-200);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: var(--clr-mist);
    border-bottom: 1px solid var(--clr-gray-200);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .table-status-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--clr-gray-700);
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
    animation: pulse-glow 2s infinite;
  }

  .status-dot.online {
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
  }

  .table-search-wrap {
    position: relative;
    min-width: 240px;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.9rem;
    opacity: 0.5;
    pointer-events: none;
  }

  .table-search-wrap input {
    width: 100%;
    padding: 0.5rem 0.85rem 0.5rem 2.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--clr-gray-300);
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .table-search-wrap input:focus {
    border-color: var(--clr-emerald-600);
    box-shadow: 0 0 0 3px rgba(219, 39, 119, 0.15);
  }

  /* Responsive Table */
  .table-responsive {
    overflow-x: auto;
  }

  .demo-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .demo-table th {
    background: #ffffff;
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--clr-gray-600);
    border-bottom: 2px solid var(--clr-gray-200);
  }

  .demo-table td {
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--clr-gray-100);
    color: var(--clr-gray-700);
    vertical-align: middle;
  }

  .demo-table tbody tr {
    transition: background var(--transition-fast);
  }

  .demo-table tbody tr:hover {
    background: var(--clr-emerald-50);
  }

  .demo-table tfoot .total-row {
    background: var(--clr-sage-100);
    border-top: 2px solid var(--clr-sage-200);
    color: var(--clr-sage-700);
    font-weight: 800;
  }

  .demo-table tfoot td {
    padding: 1.1rem 1.25rem;
    border-bottom: none;
    font-size: 0.95rem;
  }

  /* Progress Bar Cell */
  :global(.prop-bar-cell) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.prop-track) {
    flex-grow: 1;
    height: 8px;
    background: var(--clr-gray-200);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  :global(.prop-fill) {
    height: 100%;
    background: linear-gradient(90deg, var(--clr-emerald-600), var(--clr-emerald-400));
    border-radius: var(--radius-full);
    transition: width 0.8s ease;
  }

  :global(.prop-val) {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--clr-gray-600);
    min-width: 42px;
    text-align: right;
  }

  /* Skeleton Loading */
  .row-skeleton td {
    padding: 1.25rem;
  }

  .skeleton-line {
    height: 16px;
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    border-radius: 4px;
    animation: shimmer 1.5s infinite;
  }

  /* ===== WIDGETS STYLING ===== */
  .demografi-widgets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .widget-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .widget-card {
    background: #ffffff;
    border: 1px solid var(--clr-gray-200);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .widget-card:hover {
    box-shadow: var(--shadow-md);
  }

  .widget-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--clr-gray-100);
  }
  .widget-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .widget-icon { font-size: 1.4rem; }
  .widget-heading {
    display: block;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--clr-gray-900);
    line-height: 1.2;
  }
  .widget-sub {
    font-size: 0.72rem;
    color: var(--clr-gray-500);
    font-weight: 500;
  }
  .widget-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }
  .badge-green { background: #d1fae5; color: #065f46; }
  .badge-blue  { background: #dbeafe; color: #1e40af; }
  .badge-amber { background: #fef3c7; color: #92400e; }

  :global(.widget-loading) {
    font-size: 0.8rem;
    color: var(--clr-gray-400);
    font-style: italic;
    padding: 1rem 0;
    text-align: center;
  }

  /* Pekerjaan Item Row */
  :global(.pekerjaan-list) {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-height: 380px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }
  :global(.pekerjaan-item) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  :global(.pekerjaan-meta) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }
  :global(.pekerjaan-label) {
    font-weight: 600;
    color: var(--clr-gray-800);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  :global(.pekerjaan-val) {
    font-weight: 800;
    color: var(--clr-emerald-700);
  }
  :global(.pekerjaan-track) {
    height: 7px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
  }
  :global(.pekerjaan-fill) {
    height: 100%;
    background: linear-gradient(90deg, #059669, #10b981);
    border-radius: 999px;
    transition: width 0.8s ease;
  }

  /* Agama Grid */
  :global(.agama-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
  }
  :global(.agama-card) {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-md);
    padding: 0.75rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  :global(.agama-icon) { font-size: 1.3rem; }
  :global(.agama-name) { font-size: 0.75rem; font-weight: 700; color: #334155; }
  :global(.agama-count) { font-size: 0.9rem; font-weight: 900; color: #1e293b; line-height: 1.1; }

  /* Tenaga Kerja Grid */
  :global(.tenagakerja-list) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  :global(.tk-card) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fdf8f6;
    border: 1px solid #fed7aa;
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
  }
  :global(.tk-info) { display: flex; align-items: center; gap: 0.6rem; }
  :global(.tk-icon) { font-size: 1.3rem; }
  :global(.tk-title) { font-size: 0.82rem; font-weight: 700; color: #7c2d12; }
  :global(.tk-val) { font-size: 1rem; font-weight: 900; color: #c2410c; }

  @media (max-width: 900px) {
    .demografi-widgets-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .table-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

